# =============================================================================
# ClearNote_Dev - .gitignore
# =============================================================================

# --- ENTORNO Y SECRETOS ---
.env
secrets/*
!secrets/README.md

# --- PYTHON ---
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
*.egg-info/
dist/
build/

# --- UV ---
# uv.lock SÍ se versiona (builds reproducibles) → NO se ignora, a propósito.
# (En .gitignore los comentarios van en su propia línea; un "#" al final de un
#  patrón se toma como parte del patrón y lo rompe.)

# --- JUPYTER ---
.ipynb_checkpoints/
*.ipynb~

# --- DATOS (Nunca versionar datos reales o pesados) ---
# Ignora el CONTENIDO de storage pero conserva las carpetas y sus README
# (para que la estructura viaje con la plantilla).
data/storage/**
!data/storage/**/
!data/storage/**/README.md
# Fixtures de tests: ignora datos pesados, conserva la carpeta y su README.
data/tests/*.csv
data/tests/*.xlsx
data/tests/*.pdf

# --- MLFLOW ---
mlruns/

# --- BASE DE DATOS LOCAL ---
*.sqlite
*.db

# --- SISTEMA OPERATIVO ---
.DS_Store
Thumbs.db

# --- IDEs ---
.idea/
*.swp
*.swo

# --- LOGS ---
*.log
logs/

# --- AutoCV: artefactos de build (derivados; se regeneran con `autocv build`) ---
# El PDF/.tex y los intermedios de LaTeX no se versionan: son salida, no fuente.
output/
.cache/
*.aux
*.bcf
*.bbl
*.blg
*.run.xml
*.fls
*.fdb_latexmk
*.out
*.synctex.gz
*.xmpi

# La versión en INGLÉS se DERIVA del español con DeepL (no se versiona; regenerable).
data/en/

# El .env real está ignorado arriba; la PLANTILLA .env.example SÍ se versiona.
!.env.example