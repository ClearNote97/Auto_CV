{
  // Nombre que aparece en la lista de Dev Containers. Se resuelve al abrir.
  "name": "${localWorkspaceFolderBasename}",

  // Orquestación: usamos docker-compose que está en la carpeta raíz del repo
  "dockerComposeFile": "../docker-compose.yml",
  "service": "app-dev",

  // initializeCommand (HOST, antes de levantar): vincula APP_NAME al nombre de la carpeta,
  // para que el mount (${APP_NAME}) y workspaceFolder (${localWorkspaceFolderBasename}) NUNCA diverjan.
  // Crea .env desde el ejemplo si falta y GENERA el secreto de la DB si no existe (docker-compose
  // lo monta como bind y falla si el archivo no está). Requiere shell POSIX + openssl en el host (WSL/Linux/macOS).
  "initializeCommand": "bash -lc 'cp -n .env.example .env 2>/dev/null || true; d=$(basename \"$PWD\"); sed -i -E \"s|^APP_NAME=[^#]*|APP_NAME=$d  |\" .env 2>/dev/null || true; mkdir -p secrets; [ -s secrets/db_password.txt ] || openssl rand -base64 24 > secrets/db_password.txt'",

  // runServices: lista de servicios que deseamos arrancar junto al contenedor.
  // - Mantén "db" y "app-dev" por defecto.
  // - Para activar un servicio opcional, descomenta su línea aquí y en docker-compose.yml.
  "runServices": [
    // "db",
    "app-dev"
    // "timescaledb",     // Alternativa a 'db' para series de tiempo (TimescaleDB, PG18)
    // "prefect-server",  // Orquestación/Plataforma de flujos (Prefect 3)
    // "mlflow",          // Tracking de modelos (MLflow)
    // "reflex",          // Frontend web runtime (Reflex)
    // "flet",            // Frontend desktop/mobile (Flet)
    // "nginx"            // Reverse proxy / gateway
  ],

  // Al cerrar VS Code, paramos el compose (no lo eliminamos)
  "shutdownAction": "stopCompose",

  // ------------------------------------------------------------
  // IMPORTANT: NO incluimos "workspaceMount" aquí.
  // - El montaje del código se gestiona desde docker-compose.yml (recomendado).
  // - Tener workspaceMount + volumen en docker-compose provoca conflictos en Windows.
  // ------------------------------------------------------------

  // Ruta dentro del contenedor donde VS Code abrirá la carpeta.
  // Debe coincidir con el working_dir / volumen definido en docker-compose.
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "customizations": {
    "vscode": {
      // ------------------------------------------------------------
      // Configs de editor (ajusta según tu preferencia)
      // ------------------------------------------------------------
      "settings": {
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        // Intérprete Python esperado dentro del workspace montado
        "python.defaultInterpreterPath": "/workspaces/${localWorkspaceFolderBasename}/.venv/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "python.analysis.inlayHints.variableTypes": true,
        "python.analysis.inlayHints.functionReturnTypes": true,
        "editor.wordWrap": "on",
        "workbench.iconTheme": "material-icon-theme"
      },

      // ------------------------------------------------------------
      // Extensiones recomendadas / dependencias explícitas
      // ------------------------------------------------------------
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",            // requerida por ms-python
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "ms-toolsai.vscode-jupyter-slideshow",    // requerida por jupyter
        "tamasfe.even-better-toml",
        "christian-kohler.path-intellisense",
        "pkief.material-icon-theme",
        "sst-dev.opencode",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ]
    }
  },

  // Usuario dentro del contenedor (root para simplicidad en dev)
  "remoteUser": "root",

  // Puertos que queremos exponer automáticamente en el host
  "forwardPorts": [5432],
  "portsAttributes": {
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "notify"
    }
  },

  // ------------------------------------------------------------
  // postCreateCommand: en dev, init.sh deja el entorno LISTO (autodetecta contexto):
  // - deps (uv, Estado 0/N) + gobernanza (admin) + migraciones (alembic).
  // - dentro del devcontainer salta el compose up (la DB ya esta arriba).
  // - solo en dev (APP_ENV); en prod la gobernanza va por run-admin.sh.
  // ------------------------------------------------------------
  "postCreateCommand": "bash init.sh"
}