# =============================================================================
# AutoCV — variables de entorno (plantilla). Copia este archivo a `.env` y
# rellena los valores. El `.env` real NUNCA se versiona (está en .gitignore).
# =============================================================================

# --- Traducción (DeepL) ---
# Requerida SOLO para generar la versión en inglés (`autocv build --lang en`).
# La versión en español no la necesita. El plan Free de DeepL sirve:
#   https://www.deepl.com/pro-api
DEEPL_API_KEY=your-deepl-api-key-here

# --- Logging (opcional) ---
# Sobreescribe el nivel de logging.level de config.yaml.
# LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR
